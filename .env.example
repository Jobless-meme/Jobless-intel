# Solana RPC endpoint (public mainnet-beta RPC is rate-limited/unreliable —
# use a real provider: Helius, Triton, QuickNode, etc.)
NEXT_PUBLIC_SOLANA_RPC_URL=
# Optional server-only RPC for /api/v1/leaderboard/sync (falls back to the
# public one above). The sync route reads ~120 transactions per run, so a
# real provider matters more here than anywhere else.
SOLANA_RPC_URL=

# Solana — Jupiter referral fee account (must be created via Jupiter's
# Referral Program for each (mint, project) pair before it's valid on /swap)
MY_JUPITER_REFERRAL_FEE_ACCOUNT=

# BSC RPC endpoint (defaults to Binance's public dataseed — fine for dev,
# get a real provider — Ankr, NodeReal, QuickNode — before real volume)
NEXT_PUBLIC_BSC_RPC_URL=

# BSC — 0x swap fee recipient address + API key
MY_BSC_FEE_RECIPIENT_ADDRESS=
ZEROX_API_KEY=

# Fiat on-ramp
ROBINHOOD_CONNECT_APP_ID=

# Supabase — NEXT_PUBLIC_SUPABASE_ANON_KEY is safe to expose (RLS protects
# the data, not this key). SUPABASE_SERVICE_ROLE_KEY must NEVER get a
# NEXT_PUBLIC_ prefix — it bypasses RLS entirely and is used only inside
# app/api/auth/* server routes.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
